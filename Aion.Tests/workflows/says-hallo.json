{
  "Enabled": true,
  "Cron": "0/15 * * * * ?",
  "Variables": {
    "Exe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe"
  },
  "Steps": [
    {
      "Script": "{{ local.exe }}",
      "Args": [
        "--sleep 5",
        "--message \"Hallo NPC!\""
      ],
      "Serilog": {
        "MinimumLevel": { "Default": "Information" },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "C:\\temp\\{{ workflow.name }}-{{ step.index }}.log",
              "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}"
            }
          }
        ]
      }
    }
  ],
  "Serilog": {
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\temp\\Aion.Workflow-{{ workflow.name }}.log",
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
