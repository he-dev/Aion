{
  "IsOn": true,
  "Cron": "0/15 * * * * ?",
  "Args": {
    "Exe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe",
    "msg": "This is step {{ step.index }} from {{ workflow.name }}."
  },
  "Steps": [
    {
      "IsOn": true,
      "File": "{{ arg.exe }}",
      "ArgsOrString": "--sleep-seconds 5 --message \"{{ arg.msg }}\"",
      "Timeout": "0:00:03",
      "SerilogOrPreset": {
        "File": "logging-presets.json",
        "Name": "Console.Simple"
      }
    }
  ],
  "SerilogOrPreset": {
    "File": "logging-presets.json",
    "Name": "Workflow.Simple"
  }
}
