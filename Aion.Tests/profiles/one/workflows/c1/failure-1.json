{
  "IsOn": true,
  "Cron": "0/15 * * * * ?",
  "Variables": {
    "AionNpcExe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe",
    "Message": "This is step {{ Step.Index }} from {{ Workflow.Name }}."
  },
  "Steps": [
    {
      "IsOn": true,
      "FileName": "{{ Workflow.AionNpcExe }}",
      "Arguments": "--sleep-seconds 1 --message \"{{ Workflow.Message }}\" --exit-code 1",
      "Logging": {
        "File": "logging-presets.json",
        "Name": "Console.Simple"
      }
    }
  ],
  "Logging": {
    "File": "logging-presets.json",
    "Name": "Workflow.Simple"
  }
}
