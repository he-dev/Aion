{
  "IsOn": true,
  "Cron": "0/20 * * * * ?",
  "Args": {
    "exe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe"
  },
  "Steps": [
    {
      "IsOn": true,
      "File": "{{ arg.exe }}",
      "ArgsOrString": "--sleep-seconds 7 --message \"This is step {{ step.index }} from {{ workflow.name }}.\"",
      "SerilogOrPreset": {
        "MinimumLevel": {
          "Default": "Information"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "C:\\temp\\aion\\{{ profile.name}}\\{{ execution.mode }}\\{{ workflow.name }}\\{{ workflow.name }}-step-{{ step.index }}_.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {ConsoleStreamType} » {Message:lj}{NewLine}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 3
            }
          }
        ]
      }
    },
    {
      "IsOn": true,
      "File": "{{ arg.exe }}",
      "ArgsOrString": "--sleep-seconds 3 --message \"This is step {{ step.index }} from {{ workflow.name }}.\"",
      "SerilogOrPreset": {
        "File": "logging-presets.json",
        "Name": "Console.Simple"
      }
    }
  ],
  "SerilogOrPreset": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\temp\\aion\\{{ profile.name }}\\{{ execution.mode }}\\{{ workflow.name }}\\{{ workflow.name }}_.log",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {ProcessMessageSource} » {Message:lj}{NewLine}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 3
        }
      }
    ]
  }
}
