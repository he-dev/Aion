{
  "Enabled": true,
  "Cron": "0/30 * * * * ?",
  "Variables": {
    "NpcExe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe",
    "LoggingPreset": "Console.Simple"
  },
  "Steps": [
    {
      "Enabled": true,
      "Name": "TheFirst",
      "FileName": "{{ Workflow.NpcExe }}",
      "Arguments": [
        "--sleep", "1",
        "--message", "Hallo variables!",
        "--aion-instance", "{{ aion.instance }}",
        "--profile-name", "{{ profile.name }}",
        "--workflow-name", "{{ workflow.name }}",
        "--step-index", "{{ step.index }}",
        "--step-name", "{{ step.name }}",
        "--step-trace-id", "{{ step.traceId }}",
        "--step-span-id", "{{ step.spanId }}",
        "--step-parent-id", "{{ step.parentId }}"
      ],
      "Logging": {
        "Preset": "{{ Workflow.LoggingPreset }}"
      }
    }
  ],
  "Logging": {
    "Preset": "Workflow.Simple"
  }
}
