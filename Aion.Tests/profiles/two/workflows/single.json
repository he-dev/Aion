{
  "Enabled": true,
  "Cron": "0/5 * * * * ?",
  "Variables": {
    "NpcExe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe",
    "Message": "This is step {{ step.index }} from {{ workflow.name }}."
  },
  "Environment": {
    "Foo": "Foo"
  },
  "Steps": [
    {
      "Enabled": true,
      "FileName": "{{ Workflow.NpcExe }}",
      "Arguments": "--sleep-seconds 1 --message \"{{ Workflow.Message }}\"",
      "Environment": {
        "Bar": "Bar"
      },
      "Logging": {
        "Preset": {
          "Name": "Console.Simple"
        }
      }
    }
  ],
  "Logging": {
    "Preset": {
      "Name": "Workflow.Simple"
    }
  }
}
