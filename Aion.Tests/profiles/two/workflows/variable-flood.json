{
  "IsOn": true,
  "Cron": "0/30 * * * * ?",
  "Args": {
    "exe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe",
    "presetFile": "logging-presets.json",
    "presetName": "Console.Simple"
  },
  "Steps": [
    {
      "IsOn": true,
      "Name": "TheFirst",
      "File": "{{ arg.exe }}",
      "ArgsOrString": [
        "--sleep", "1",
        "--message", "Hallo variables!",
        "--aion-instance", "{{ aion.instance }}",
        "--profile-name", "{{ profile.name }}",
        "--workflow-name", "{{ workflow.name }}",
        "--step-index", "{{ step.index }}",
        "--step-name", "{{ step.name }}",
        "--execution-trace-id", "{{ execution.traceId }}",
        "--execution-span-id", "{{ execution.spanId }}",
        "--execution-parent-id", "{{ execution.parentId }}"
      ],
      "SerilogOrPreset": {
        "File": "{{ arg.presetFile }}",
        "Name": "{{ arg.presetName }}"
      }
    }
  ],
  "SerilogOrPreset": {
    "File": "logging-presets.json",
    "Name": "Workflow.Simple"
  }
}
