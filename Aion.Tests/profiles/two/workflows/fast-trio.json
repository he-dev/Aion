{
  "Enabled": true,
  "Cron": "0/5 * * * * ?",
  "Variables": {
    "exe": "{{ env \"DEV_HOME\" }}\\aion-svc-cs\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe",
    "msg": "This is step {{ step.index }} from {{ workflow.name }}."
  },
  "Steps": [
    {
      "Enabled": true,
      "FileName": "{{ Global.exe }}",
      "Arguments": "--sleep-seconds 2 --message \"{{ Global.msg }}\"",
      "Logging": {
        "Preset": "StepFile28Days"
      }
    },
    {
      "Enabled": true,
      "FileName": "{{ Global.exe }}",
      "Arguments": "--sleep-seconds 3 --message \"{{ Global.msg }}\"",
      "DependsOn": "$previous",
      "SerilogOrPreset": {
        "Preset": "StepFile28Days"
      }
    },
    {
      "Enabled": true,
      "FileName": "{{ Global.exe }}",
      "Arguments": "--sleep-seconds 1 --message \"{{ Global.msg }}\" --exit-code 0",
      "DependsOn": "$previous",
      "Logging": {
        "Preset": "StepFile28Days"
      }
    }
  ],
  "Logging": {
    "Preset": "WorkflowFile28Days"
  }
}
