{
  "Version": 1,
  "Presets": {
    "WorkflowFile28Days": {
      "Serilog": {
        "MinimumLevel": {
          "Default": "Debug"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "{{ Variables.LogsDirectory }}\\{{ Profile.Name }}\\{{ Workflow.Name }}-{{ Workflow.Mode }}_.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {Message:lj} | {Properties}{NewLine}{Exception}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 28
            }
          }
        ]
      }
    },
    "StepFile28Days": {
      "Serilog": {
        "MinimumLevel": {
          "Default": "Information"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "{{ Variables.LogsDirectory }}\\{{ Profile.Name }}\\{{ Workflow.Name }}-{{ Workflow.Mode }}-step-{{ Step.Index }}-std_.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {ConsoleStreamType} » {Message:lj}{NewLine}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 28
            }
          }
        ]
      }
    },
    "StepFile28DaysCompact": {
      "Serilog": {
        "MinimumLevel": {
          "Default": "Information"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "{{ Variables.LogsDirectory }}\\{{ Profile.Name }}\\{{ Workflow.Name }}-{{ Workflow.Mode }}-step-{{ Step.Index }}-std_.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 28
            }
          }
        ]
      }
    }
  }
}