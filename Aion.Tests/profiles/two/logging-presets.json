{
  "Version": 1,
  "Presets": [
    {
      "Name": "Profile.Simple",
      "Serilog": {
        "MinimumLevel": {
          "Default": "Debug"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "{{ Instance.LogsDirectory }}\\{{ Profile.Name }}.{{ Execution.Mode }}_.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {Message:lj} | {Properties}{NewLine}{Exception}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 30
            }
          }
        ]
      }
    },
    {
      "Name": "Workflow.Simple",
      "Serilog": {
        "MinimumLevel": {
          "Default": "Debug"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "{{ Instance.LogsDirectory }}\\{{ Profile.Name }}.{{ Execution.Mode }}\\{{ Workflow.Name }}\\{{ Workflow.Name }}_.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {Message:lj} | {Properties}{NewLine}{Exception}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 30
            }
          }
        ]
      }
    },
    {
      "Name": "Console.Simple",
      "Serilog": {
        "MinimumLevel": {
          "Default": "Information"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "{{ Instance.LogsDirectory }}\\{{ Profile.Name }}.{{ Execution.Mode }}\\{{ Workflow.Name }}\\{{ Workflow.Name }}-s{{ step.index }}_.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {ConsoleStreamType} » {Message:lj}{NewLine}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 30
            }
          }
        ]
      }
    }
  ]
}