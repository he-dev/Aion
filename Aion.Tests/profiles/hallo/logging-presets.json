{
  "Version": 1,
  "Presets": {
    "WorkflowFile28Days": {
      "Serilog": {
        "MinimumLevel": {
          "Default": "Debug"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "{{ Parameters.LogsDirectory }}\\{{ Profile.Name }}\\{{ Workflow.Mode }}\\{{ Workflow.Name }}_.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {SourceContext} {Message:lj} | {Properties}{NewLine}{Exception}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 28
            }
          }
        ]
      }
    },
    "StepFile28Days": {
      "Serilog": {
        "MinimumLevel": {
          "Default": "Information"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "{{ Parameters.LogsDirectory }}\\{{ Profile.Name }}\\{{ Workflow.Mode }}\\{{ Workflow.Name }}-step-{{ Step.Index | object.format 'D2' }}_.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] [{ConsoleStreamType}] {Message:lj}{NewLine}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 28
            }
          }
        ]
      }
    }
  }
}