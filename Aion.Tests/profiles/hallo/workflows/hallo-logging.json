{
  "Enabled": true,
  "Cron": "0/20 * * * * ?",
  "Parameters": {
    "exe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe"
  },
  "Steps": [
    {
      "Enabled": true,
      "FileName": "{{ arg.exe }}",
      "Arguments": "--sleep-seconds 7 --message \"This is step {{ step.index }} from {{ workflow.name }}.\"",
      "Logging": {
        "Custom": {
          "MinimumLevel": {
            "Default": "Information"
          },
          "WriteTo": [
            {
              "Name": "File",
              "Args": {
                "path": "C:\\temp\\aion\\{{ profile.name}}\\{{ execution.mode }}\\{{ workflow.name }}\\{{ workflow.name }}-step-{{ step.index }}_.log",
                "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {ConsoleStreamType} » {Message:lj}{NewLine}",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 3
              }
            }
          ]
        }
      }
    },
    {
      "Enabled": true,
      "FileName": "{{ arg.exe }}",
      "Arguments": "--sleep-seconds 3 --message \"This is step {{ step.index }} from {{ workflow.name }}.\"",
      "Logging": {
        "Preset": "Console.Simple"
      }
    }
  ],
  "Logging": {
    "Custom": {
      "MinimumLevel": {
        "Default": "Information"
      },
      "WriteTo": [
        {
          "Name": "File",
          "Args": {
            "path": "C:\\temp\\aion\\{{ profile.name }}\\{{ execution.mode }}\\{{ workflow.name }}\\{{ workflow.name }}_.log",
            "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {ProcessMessageSource} » {Message:lj}{NewLine}",
            "rollingInterval": "Day",
            "retainedFileCountLimit": 3
          }
        }
      ]
    }
  }
}
