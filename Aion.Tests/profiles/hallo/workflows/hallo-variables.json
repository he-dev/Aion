{
  "Enabled": true,
  "Cron": "0/30 * * * * ?",
  "Variables": {
    "LoggingPreset": "ConsoleFile28Days"
  },
  "Steps": [
    {
      "Enabled": true,
      "Name": "TheFirst",
      "FileName": "{{ Variables.NpcExe }}",
      "Arguments": {
        "--sleep-seconds": 0,
        "--message": "Hallo variables!",
        "--scheduler": "{{ Scheduler.Name }}",
        "--profile[]": [
          "foo",
          "{{ Profile.Name }}"
        ],
        "--workflow": "{{ Workflow.Name }}",
        "--step-index": "{{ Step.Index }}",
        "--step-name": "{{ Step.Name }}",
        "--step-trace-id": "{{ Step.TraceId }}",
        "--step-span-id": "{{ Step.SpanId }}",
        "--step-parent-id": "{{ Step.ParentId }}"
      },
      "Logging": {
        "Preset": "StepFile28Days"
      }
    }
  ],
  "Logging": {
    "Preset": "WorkflowFile28Days"
  }
}
