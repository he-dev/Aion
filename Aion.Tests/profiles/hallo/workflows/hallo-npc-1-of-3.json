{
  "Enabled": true,
  "Cron": "0/5 * * * * ?",
  "Parameters": {
    "NpcMsg": "This is step {{ Step.Index }} from {{ Workflow.Name }}."
  },
  "Steps": [
    {
      "Enabled": true,
      "FileName": "{{ Variables.NpcExe }}",
      "Arguments": {
        "--sleep-seconds": 2,
        "--message": "\"{{ Variables.NpcMsg }}\""
      },
      "Logging": {
        "Preset": "StepFile28Days",
        "Target": "Self, Main"
      }
    },
    {
      "Enabled": false,
      "FileName": "{{ Variables.NpcExe }}",
      "Arguments": {
        "--sleep-seconds": 1,
        "--message": "\"{{ Variables.NpcMsg }}\""
      },
      "Logging": {
        "Preset": "StepFile28Days"
      }
    },
    {
      "Enabled": true,
      "FileName": "{{ Variables.NpcExe }}",
      "Arguments": {
        "--sleep-seconds": 2,
        "--message": "\"{{ Variables.NpcMsg }}\"",
        "--exit-code": 1
      },
      "OnFailure": "break",
      "Logging": {
        "Preset": "StepFile28Days"
      }
    }
  ],
  "Logging": {
    "Preset": "WorkflowFile28Days"
  }
}
