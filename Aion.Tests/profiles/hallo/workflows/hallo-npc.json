{
  "Enabled": true,
  "Cron": "0/5 * * * * ?",
  "Parameters": {
    "Message": "This is step {{ Step.Index }} from {{ Workflow.Name }}."
  },
  "Environment": {
    "NPC_MODE": "test"
  },
  "Steps": [
    {
      "Enabled": true,
      "FileName": "{{ Parameters.NpcExe }}",
      "Arguments": {
        "--sleep-seconds": 1,
        "--message": "\"{{ Parameters.Message }}\""
      },
      "Environment": {
        "Bar": "Bar"
      },
      "Logging": {
        "Preset": "StepFile28Days"
      }
    }
  ],
  "Logging": {
    "Preset": "WorkflowFile28Days"
  }
}
