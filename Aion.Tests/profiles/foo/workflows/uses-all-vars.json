{
  "IsOn": true,
  "Cron": "0/15 * * * * ?",
  "Args": {
    "Exe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe"
  },
  "Steps": [
    {
      "IsOn": true,
      "File": "{{ arg.exe }}",
      "Args": [
        "--sleep 5",
        "--message \"Hallo variables!\"",
        "--profile-name {{ profile.name }}",
        "--workflow-name {{ workflow.name }}",
        "--workflow-trigger {{ workflow.trigger }}",
        "--workflow-trace-id {{ workflow.traceId }}",
        "--workflow-span-id {{ workflow.spanId }}",
        "--step-index {{ step.index }}",
        "--step-trace-id {{ step.trace-id }}",
        "--step-span-id {{ step.span-id }}"
      ],
      "Console": {
        "MinimumLevel": {
          "Default": "Information"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "C:\\temp\\{{ workflow.name }}-{{ step.index }}.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {ProcessMessageSource} » {Message:lj}{NewLine}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 3
            }
          }
        ]
      }
    }
  ]
}
