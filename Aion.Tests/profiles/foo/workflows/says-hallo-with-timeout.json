{
  "IsOn": true,
  "Cron": "0/15 * * * * ?",
  "Args": {
    "Exe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe"
  },
  "Steps": [
    {
      "IsOn": true,
      "File": "{{ arg.exe }}",
      "Args": [
        "--sleep 10",
        "--message \"Hallo NPC!\""
      ],
      "Timeout": "0:00:05",
      "Console": {
        "MinimumLevel": {
          "Default": "Information"
        },
        "WriteTo": [
          {
            "Name": "File",
            "Args": {
              "path": "C:\\temp\\{{ workflow.name }}-{{ step.index }}.log",
              "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {ProcessMessageSource} » {Message:lj}{NewLine}",
              "rollingInterval": "Day",
              "retainedFileCountLimit": 3
            }
          }
        ]
      }
    }
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\temp\\Aion.Workflow-{{ workflow.name }}.log",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {Message:lj} | {Properties}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 3
        }
      }
    ]
  }
}
