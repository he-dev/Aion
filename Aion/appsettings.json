{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5049"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorkflowEngine": {
    "WorkflowFileType": "yaml",
    "WorkflowFiles": [
      "**\\*.yaml",
      "**\\*.json"
    ],
    "WorkflowDirectory": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\workflows"
  },
  "SynchronizationJob": {
    "Cron": "0 0/15 * * * ?"
  },
  "QuartzServer": {
    "StartDelaySeconds": 10
  },
  "StandbyEngine": {
    "PendingPath": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\standbys",
    "ExpiredPath": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\standbys\\expired"
  }
}
