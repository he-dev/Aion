{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5049"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorkflowEngine": {
    "WorkflowDirectory": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\workflows",
    "TimeZoneId": "W. Europe Standard Time"
  },
  "WorkflowDirectory": {
    "Path": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\workflows"
  },
  "WorkflowExecutionLog": {
    "Path": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\workflows",
    "OutputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u4}] {SourceContext} {Message:lj} {Properties}{NewLine}{Exception}",
    "RollingInterval": "Day",
    "RetainedFileCountLimit": 3
  },
  "SynchronizationJob": {
    "Cron": "0 0/15 * * * ?",
    "TimeZoneId": "W. Europe Standard Time"
  },
  "QuartzServer": {
    "StartDelaySeconds": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u4}] {SourceContext} {Message:lj} {Properties}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Sixteen, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\temp\\Aion.json",
          "formatter": "Serilog.Formatting.Json.JsonFormatter",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 3
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\temp\\Aion.Console.log",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u4}] {SourceContext} {Message:lj} {Properties}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 3
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Aion"
    }
  }
}
