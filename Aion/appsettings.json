{
  "Instance": {
    "Name": "Cygnus",
    "Variables": {
      "TestsDirectory": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests",
      "LogsDirectory": "c:\\temp\\aion"
    },
    "Profiles": [
      {
        "Path": "{{ Instance.TestsDirectory }}\\profiles\\one",
        "Sync": "0 0/20 * * * ?",
        "SyncOn": false,
        "Variables": {
          "test": "test"
        },
        "Includes": [
          "workflows\\**\\*.json"
        ],
        "Excludes": [],
        "Logging": {
          "Preset": {
            "Name": "Profile.Simple"
          }
        }
      },
      {
        "Path": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\profiles\\two",
        "Sync": "0 0/20 * * * ?",
        "SyncOn": true,
        "Includes": [
          "workflows\\**\\*.json"
        ],
        "Excludes": []
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5049"
      }
    }
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "QuartzServer": {
    "StartDelaySeconds": 10
  }
}
