{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5049"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorkflowEngine": {
    "WorkflowFileType": "yaml",
    "WorkflowDirectory": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\workflows"
  },
  "SynchronizationJob": {
    "Cron": "0 0/15 * * * ?"
  },
  "QuartzServer": {
    "StartDelaySeconds": 10
  },
  "MaintenanceToken": {
    "PendingPath": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\maintenance-tokens",
    "ExpiredPath": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\maintenance-tokens\\expired"
  }
}
