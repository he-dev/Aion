{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5049"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Aion": {
    "Name": "AionDev",
    "SyncOn": true,
    "Profiles": [
      {
        "Path": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\profiles\\one",
        "Sync": "0 0/15 * * * ?"
      },
      {
        "Path": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\profiles\\two",
        "Sync": "0 0/20 * * * ?"
      }
    ]
  },
  "QuartzServer": {
    "StartDelaySeconds": 10
  }
}
