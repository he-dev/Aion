<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>default</LangVersion>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.17" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="9.0.6" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="9.0.6" />
        <PackageReference Include="Quartz.AspNetCore" Version="3.14.0" />
        <PackageReference Include="Scriban" Version="6.2.1" />
        <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
        <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
        <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.1" />
        <PackageReference Include="System.Linq.Async" Version="6.0.3" />
    </ItemGroup>
    
    

    <ItemGroup>
      <Content Update="workflows\foo.yaml">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Core\Utilities\LatestVersion.cs" />
      <Compile Remove="src\Core\Utilities\LatestVersion.cs" />
      <Compile Remove="src\Core\Util\LatestVersion.cs" />
      <Compile Remove="src\Util\AsyncProcess__.cs" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="workflows\offline\one-step.json" />
      <_ContentIncludedByDefault Remove="workflows\sub\qux.json" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="src.zip" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="src\Meta\Services\" />
    </ItemGroup>



</Project>
