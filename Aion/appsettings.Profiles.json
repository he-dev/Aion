{
  "Scheduler": {
    "Name": "Test",
    "StartDelay": "00:00:10",
    "Shutdown": {
      "Enabled": true,
      "Cron": "0 0/20 * * * ?",
      "ExitCode": 1
    },
    "Parameters": {
      "ProfilesDirectory": "{{ Environment.AION_HOME }}\\Aion.Tests\\profiles",
      "NpcExe": "{{ Environment.AION_HOME }}\\Aion.Npc\\bin\\Debug\\net10.0\\Aion.Npc.exe",
      "LogsDirectory": "{{ Environment.TEMP }}\\aion\\{{ Scheduler.Name }}"
    },
    "Profiles": {
      "tests": {
        "Path": "{{ Parameters.ProfilesDirectory }}\\tests",
        "Sync": {
          "Enabled": false,
          "Cron": "0 0/20 * * * ?"
        },
        "Parameters": {
          "test": "test"
        },
        "Workflows": {
          "Includes": [
            "**\\*.json"
          ],
          "Excludes": []
        }
      },
      "hallo": {
        "Path": "{{ Parameters.ProfilesDirectory }}\\hallo",
        "Sync": {
          "Enabled": true,
          "Cron": "0 0/20 * * * ?"
        },
        "Workflows": {
          "Includes": [
            "**\\*.json"
          ],
          "Excludes": []
        }
      }
    }
  }
}
