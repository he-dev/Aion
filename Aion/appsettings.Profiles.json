{
  "Scheduler": {
    "Name": "Test",
    "Variables": {
      "ProfilesDirectory": "{{ env \"DEV_HOME\" }}\\aion-svc-cs\\Aion.Tests\\profiles",
      "LogsDirectory": "{{ env \"TEMP\" }}\\aion\\{{ Scheduler.Name }}"
    },
    "Profiles": {
      "one": {
        "Enabled": false,
        "Path": "{{ Global.ProfilesDirectory }}\\{{ Profile.Name }}",
        "Sync": "0 0/20 * * * ?",
        "Variables": {
          "test": "test"
        },
        "Includes": [
          "workflows\\**\\*.json"
        ],
        "Excludes": [],
        "Logging": {
          "Preset": {
            "Name": "Profile.Simple"
          }
        }
      },
      "two": {
        "Enabled": true,
        "Path": "{{ Global.ProfilesDirectory }}\\{{ Profile.Name }}",
        "Sync": "0 0/20 * * * ?",
        "Includes": [
          "workflows\\**\\*.json"
        ],
        "Excludes": []
      }
    }
  }
}
