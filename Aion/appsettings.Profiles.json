{
  "Scheduler": {
    "Name": "Test",
    "StartDelay": "00:00:10",
    "Shutdown": {
      "Enabled": true,
      "Cron": "0 0/20 * * * ?",
      "ExitCode": 1
    },
    "Variables": {
      "ProfilesDirectory": "{{ env \"AION_HOME\"}}\\Aion.Tests\\profiles",
      "NpcExe": "{{ env \"AION_HOME\"}}\\Aion.Npc\\bin\\Debug\\net10.0\\Aion.Npc.exe",
      "LogsDirectory": "{{ env \"TEMP\" }}\\aion\\{{ Scheduler.Name }}"
    },
    "Profiles": {
      "one": {
        "Path": "{{ Variables.ProfilesDirectory }}\\one",
        "Sync": {
          "Enabled": false,
          "Cron": "0 0/20 * * * ?"
        },
        "Variables": {
          "test": "test"
        },
        "Workflows": {
          "Includes": [
            "**\\*.json"
          ],
          "Excludes": []
        }
      },
      "two": {
        "Path": "{{ Variables.ProfilesDirectory }}\\two",
        "Sync": {
          "Enabled": true,
          "Cron": "0 0/20 * * * ?"
        },
        "Workflows": {
          "Includes": [
            "**\\*.json"
          ],
          "Excludes": []
        }
      }
    }
  }
}
