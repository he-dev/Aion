{
  "Serilog": {
    "Using": [
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByExcluding",
                "Args": {
                  "expression": "ConsoleStreamType in ['StdOut', 'StdErr']"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "Console",
                "Args": {
                  "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u4}] {SourceContext} | {Message:lj} {Properties}{NewLine}{Exception}",
                  "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Sixteen, Serilog.Sinks.Console"
                }
              },
              {
                "Name": "File",
                "Args": {
                  "path": "C:\\temp\\aion\\Aion.Elastic.json",
                  "formatter": "Serilog.Formatting.Json.JsonFormatter",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 3
                }
              },
              {
                "Name": "File",
                "Args": {
                  "path": "C:\\temp\\aion\\Aion.Default.log",
                  "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u4}] {SourceContext} {Message:lj} {Properties}{NewLine}{Exception}",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 3
                }
              }
            ]
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Aion"
    }
  }
}
