{
  "Engine": {
    "Name": "Cygnus",
    "Variables": {
      "TestsDirectory": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests",
      "LogsDirectory": "c:\\temp\\aion\\{{ Engine.Name }}"
    },
    "Profiles": [
      {
        "Enabled": false,
        "Path": "{{ Engine.TestsDirectory }}\\profiles\\one",
        "Sync": "0 0/20 * * * ?",
        "Variables": {
          "test": "test"
        },
        "Includes": [
          "workflows\\**\\*.json"
        ],
        "Excludes": [],
        "Logging": {
          "Preset": {
            "Name": "Profile.Simple"
          }
        }
      },
      {
        "Enabled": true,
        "Path": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Tests\\profiles\\two",
        "Sync": "0 0/20 * * * ?",
        "Includes": [
          "workflows\\**\\*.json"
        ],
        "Excludes": []
      }
    ]
  }
}
